# Three minutes of Aurora, from the top, with a fixed seed: the piece taken up, saved and booted, so that it starts in its own key and style. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/preset_aurora.amb app/build/listen
wait 100
turn PRESET 4
tap SAVE
reboot
seed 3005
master 2430
trace app/build/listen/preset_aurora.trace
wav preset_aurora.wav
wait 180000
wavstop
trace off
expect piece 4
expect seed 3005
