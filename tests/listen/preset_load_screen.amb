# Three minutes of Load Screen, from the top, with a fixed seed: the piece taken up, saved and booted, so that it starts in its own key and style. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/preset_load_screen.amb app/build/listen
wait 100
tap SAVE
reboot
seed 3001
master 2430
trace app/build/listen/preset_load_screen.trace
wav preset_load_screen.wav
wait 180000
wavstop
trace off
expect piece 0
expect seed 3001
