# hold, next section, rest, save and reboot
wait 2000
tap REC
wait 50
expect held 1
shot held.png
wait 3000
tap REC
wait 50
expect held 0
# the next section comes on the bar
tap EDIT
wait 4000
tap OCT+
expect par11 1
tap ENV
spin K1 -20
expect par4 40
tap PLAY
wait 50
expect playing 0
wait 50000
expect pad_level >50
shot resting.png
# a rest sounds, and saves itself under it, through the duck: once, four seconds after the last touch; nothing to save after that; SAVE still does
wait 5000
expect dirty 0
expect store_writes 1
expect writepeak 0
wait 5000
expect store_writes 1
tap SAVE
wait 800
expect dirty 0
expect store_writes 2
reboot
wait 300
expect par4 40
expect par11 1
expect playing 1
