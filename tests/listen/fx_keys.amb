# The keys' effects, on Load Screen, in context: the melody low, the bass, the drums and the hats low, in Phrases. Off for 20 s; then each of Chorus, Autopan, Tremolo, Filter: 30 s at Motion 0, still, and 30 s at Motion 70, moving, the next section asked for 10 s into that (Hands). Depth 50, the default. The times are in the file.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/fx_keys.amb app/build/listen
setpar 32 0
wait 100
tap SAVE
wait 800
reboot
seed 3101
master 2430
setpar 2 50
press SEL
tap ARP
tap LFO
tap SEQ
tap FX
release SEL
setpar 12 25
setpar 16 22
setpar 18 25
setpar 8 45
wait 3000
trace app/build/listen/fx_keys.trace
wav fx_keys.wav
tap FX
wait 100
expect par36 0
# 0:00 Off
wait 20000
press SEL
spin K1 1
expect par36 1
release SEL
setpar 37 0
# 0:20 Chorus Motion 0
echo Chorus Motion 0
wait 29900
setpar 37 70
# 0:50 Chorus Motion 70
echo Chorus Motion 70
wait 10000
tap EDIT
wait 19900
press SEL
spin K1 1
expect par36 2
release SEL
setpar 37 0
# 1:20 Autopan Motion 0
echo Autopan Motion 0
wait 29900
setpar 37 70
# 1:50 Autopan Motion 70
echo Autopan Motion 70
wait 10000
tap EDIT
wait 19900
press SEL
spin K1 1
expect par36 3
release SEL
setpar 37 0
# 2:20 Tremolo Motion 0
echo Tremolo Motion 0
wait 29900
setpar 37 70
# 2:50 Tremolo Motion 70
echo Tremolo Motion 70
wait 10000
tap EDIT
wait 19900
press SEL
spin K1 1
expect par36 4
release SEL
setpar 37 0
# 3:20 Filter Motion 0
echo Filter Motion 0
wait 29900
setpar 37 70
# 3:50 Filter Motion 70
echo Filter Motion 70
wait 10000
tap EDIT
wait 19900
wavstop
trace off
