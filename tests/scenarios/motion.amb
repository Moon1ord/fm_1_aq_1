# hold, next section, rest, save and reboot
wait 2000
tap REC
wait 50
expect held 1
shot held.png
wait 3000
tap REC
wait 50
expect held 0
# the next section comes on the bar
tap EDIT
wait 4000
tap OCT+
expect par11 1
tap ENV
spin K1 -20
expect par4 40
tap PLAY
wait 50
expect playing 0
wait 50000
expect pad_level >50
shot resting.png
# a rest sounds now: nothing saves itself under it until saving can dip the volume; SAVE does
wait 5000
expect dirty 1
expect store_writes 0
tap SAVE
expect dirty 0
expect store_writes >0
reboot
wait 300
expect par4 40
expect par11 1
expect playing 1
