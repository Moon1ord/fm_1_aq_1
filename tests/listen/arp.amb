# Arp on Load Screen, played by hand: the keys, the pad, the bass, hats and drums on, then the melody in Arp: each pattern at each division, about 20 s each, Up, Down, Up-Down, Random at 1/8, then at 1/4, then at 1/16, in the melody's Auto timbre; then one sound through its divisions. The times: the report of the change, and "arp" lines in the log. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/arp.amb app/build/listen
wait 100
tap SAVE
wait 800
reboot
seed 3001
master 2430
trace app/build/listen/arp.trace
wav arp.wav
press SEL
tap LFO
tap SEQ
tap FX
tap ARP
release SEL
tap ARP
wait 100
# 0:00 the mode: Arp. Rate 50, 1/8
press SEL
spin K2 1
release SEL
expect par32 1
echo arp 1/8 up
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/8 down
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/8 up-down
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/8 random
wait 20000
# 1:20 Rate 20: 1/4
setpar 9 20
press SEL
setpar 33 0
wait 1
release SEL
echo arp 1/4 up
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/4 down
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/4 up-down
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/4 random
wait 20000
# 2:40 Rate 85: 1/16
setpar 9 85
press SEL
setpar 33 0
wait 1
release SEL
echo arp 1/16 up
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/16 down
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/16 up-down
wait 20000
press SEL
spin K3 1
release SEL
echo arp 1/16 random
wait 20000
# 4:00 the longest release: Glass, at a sixteenth, up-down, then back to Phrases
press SEL
spin K3 -1
spin K1 1
spin K1 1
spin K1 1
spin K1 1
spin K1 1
spin K1 1
release SEL
expect par31 6
expect par33 2
echo arp 1/16 up-down glass
wait 20000
press SEL
spin K2 1
release SEL
expect par32 0
echo phrases
wait 20000
wavstop
trace off
expect piece 0
