# Six minutes of the chords in A aeolian, with a fixed seed. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/chords_aeolian.amb app/build/listen
# (in Auto, saved, as it boots: this is the arranger's, from the top. Hands is the power-on's: hands.amb, preset_*.amb)
press SEL
tap HOME
release SEL
tap SAVE
wait 800
reboot
master 2430
tap PLAY
wait 200
seed 2003
style liquid
turn ALGO 2
expect pool 0x5AD
tap GLO
spin K1 7
tap HOME
wait 200
trace app/build/listen/chords_aeolian.trace
wav chords_aeolian.wav
tap PLAY
wait 360000
wavstop
trace off
