# the screen reader (fm1-reader, announce.c): a reader listens, and each page, knob, help card, button and
# chord change is said once, in the screen's own text (the words file says it in full)
wait 200
listen
wait 100
said Home page: Tempo 170, Energy 70, Evolve 50, Style Liquid. Piece Aqua, D Lydian, growing
# (the garden follows, queued: the chord, how far to the next, the scale from the root up)
listen
where
said Scale D, E, F#, Ab and A, B, C#
# a page settles before it is said
tap ENV
wait 300
said Keys page: Level 60, Bloom 50, Bright 50, Notes 3
tap GLO
wait 300
said Setup page: Root D, Tune 0, MIDI out On, Lights On
# a knob: its name and value, once it settles
spin K2 3
wait 300
said Tune +3
spin K4 1
wait 300
said Lights Keys
spin K4 -1
wait 300
# SELECT turns the pages
turn SELECT -1
wait 300
said Space page: Echo 40, Echo time 1/4., Reverb 65, Size 80
spin K2 -1
wait 300
said Echo time 1/2.
tap HOME
wait 300
said Home page
spin K4 2
wait 300
said Style Jungle
# HOME + SELECT: the tempo (the first knob of Home says it)
press HOME
turn SELECT 2 200
release HOME
wait 300
said Tempo 172
# the keys: a note out of the scale and back in; the root stays
tapkey w1
said ADDED G
tapkey w1
said REMOVED G
tapkey b3
said REMOVED C#
tapkey b3
said ADDED C#
tapkey w5
said THE ROOT STAYS (SETUP)
# the encoders: the mode, the piece (with its key and tempo)
turn ALGO 1
said MODE Mixolyd
turn ALGO -1
said MODE Lydian
turn PRESET 1
said PIECE Skyline, G Ionian, tempo 172
wait 300
unsaid Level
turn PRESET -1
said PIECE Aqua, D Lydian, tempo 172
wait 300
# the buttons' messages, said once
tap REC
said HOLD ON
tap REC
said HOLD OFF
tap PLAY
said RESTING
wait 300
unsaid GROWING
tap PLAY
said GROWING
wait 300
unsaid RESTING
tap OCT+
said MOTIF OCTAVE +1
tap OCT-
said MOTIF OCTAVE 0
tap EDIT
said NEXT SECTION ON THE BAR
# SEL + EDIT: a break, where there are drums; here none yet
press SEL
tap EDIT
release SEL
said NO DRUMS NO BREAK
# a help card: its button, then its lines
press SAVE
wait 1000
said SAVE button. SAVES ALL EIGHT PIECES. KEEP HOLDING: THE PIECE BACK TO ITS RECIPE
release SAVE
tap SAVE
said SAVED
press REC
wait 1000
said REC button. HOLD: THE CHORD STAYS, NO NEW SECTION. THE REST PLAYS ON. AGAIN: LET GO
release REC
wait 100
press EDIT
wait 1000
said EDIT button. THE NEXT SECTION, ON THE NEXT BAR. + SELECT: A BREAK, ON THE NEXT BAR
release EDIT
wait 100
# the chord moving by itself: queued (said after what is being said)
wait 90000
said Chord
# a MIDI clock arriving, and start / stop from it
midi FA 00 00
midi F8 00 00
wait 20
said Tempo EXT
midi FC 00 00
wait 300
said RESTING
wait 1000
said Tempo 172
# WHERE: everything again
where
said Home page: Tempo 172, Energy 70, Evolve 50, Style Jungle. Piece Aqua, D Lydian, resting
