# Six minutes of liquid's generated rhythm, from the top, with a fixed seed (rhy_test --chart prints its bars). Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/rhy_liquid.amb app/build/listen
master 2430
tap PLAY
wait 200
seed 1001
style liquid
wait 200
trace app/build/listen/rhy_liquid.trace
wav rhy_liquid.wav
tap PLAY
wait 360000
wavstop
trace off
