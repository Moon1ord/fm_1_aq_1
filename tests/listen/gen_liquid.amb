# Six minutes of liquid, from the top, with a fixed seed. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/gen_liquid.amb app/build/listen
master 2430
tap PLAY
wait 200
seed 1001
style liquid
wait 200
trace app/build/listen/gen_liquid.trace
wav gen_liquid.wav
tap PLAY
wait 360000
wavstop
trace off
