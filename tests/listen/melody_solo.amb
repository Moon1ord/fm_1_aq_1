# The melody alone, without keys, pad, bass or drums, six minutes, its room left as it is, the timbres changing as they do; Rate up a little
# so that there is more to hear. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/melody_solo.amb app/build/listen
# (in Auto, saved, as it boots: this is the arranger's, from the top. Hands is the power-on's: hands.amb, preset_*.amb)
press SEL
tap HOME
release SEL
tap SAVE
wait 800
reboot
master 2430
tap PLAY
wait 200
seed 58
style liquid
setpar 4 0
setpar 12 0
setpar 16 0
setpar 9 75
wait 200
trace app/build/listen/melody_solo.trace
wav melody_solo.wav
tap PLAY
wait 360000
wavstop
trace off
