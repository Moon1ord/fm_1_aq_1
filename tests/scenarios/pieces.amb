# the pieces: PRESETS picks one, each remembers its settings, SAVE held resets one, all saved
wait 500
expect piece 0
# Aqua's keys down (the Keys page: ENV)
tap ENV
spin K1 -10
expect par4 50
# the next piece: Skyline, its recipe (tempo 172, G Ionian)
turn PRESET 1
expect piece 1
expect par0 172
expect par16 50
expect par24 7
expect pool 0xAB5
wait 8000
shot skyline.png
# and Bubble
turn PRESET 1
expect piece 2
expect par0 174
expect par8 80
wait 3000
# and Rainfall
turn PRESET 1
expect piece 3
wait 20000
shot rainfall.png
expect pad_level >10
# the lone notes (the Keys page's fourth knob), kept with the piece
expect par7 3
spin K4 -1
expect par7 2
wait 3000
# back to Aqua: as it was left
turn PRESET -3
expect par7 3
expect piece 0
expect par4 50
spin K4 -2
expect par7 1
turn PRESET 3
expect par7 2
turn PRESET -3
expect par7 1
# SAVE held: Aqua's recipe again
press SAVE
wait 1700
release SAVE
expect par4 60
expect par7 3
expect store_writes 0
# a tweak, saved, survives a reboot, on the piece it was made on (the Motifs page: ARP)
tap ARP
spin K1 5
expect par8 65
turn PRESET 6
expect piece 6
tap SAVE
expect store_writes 1
reboot
wait 300
expect piece 6
turn PRESET 2
expect piece 0
expect par8 65
