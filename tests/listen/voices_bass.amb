# The bass's sounds, in context: its level up, the keys and the pad, the drums and the hats low, no melody. Each sound about 30 s in turn, from the first; the time each starts: the report of this change, and "sound" lines in the log. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/voices_bass.amb app/build/listen
# (the melody in Phrases, set here: a recipe's Hands has it in Keys, and this shows the piece as it composes)
setpar 32 0
wait 300
master 2430
seed 11
setpar 2 50
press SEL
tap ARP
tap LFO
tap SEQ
tap FX
release SEL
press SEL
tap ARP
release SEL
setpar 4 32
setpar 12 62
setpar 16 22
setpar 18 25
wait 3000
trace app/build/listen/voices_bass.trace
wav voices_bass.wav
tap LFO
expect par30 0
echo sound 0
wait 30000
press SEL
spin K1 1
release SEL
expect par30 1
echo sound 1
wait 30000
press SEL
spin K1 1
release SEL
expect par30 2
echo sound 2
wait 30000
press SEL
spin K1 1
release SEL
expect par30 3
echo sound 3
wait 30000
wavstop
trace off
