# demo5: the harmony from the pool. A Aeolian: stopped first, so the song starts from its top in this key.
#   PYTHON=.venv/bin/python3 sh build.sh --host && app/build/host/aq1_host tests/listen/demo5_aeolian.amb app/build/listen
master 2430
tap PLAY
wait 200
turn ALGO 2
tap GLO
spin K1 7
tap HOME
expect par19 9
expect par20 5
expect pool 0x5AD
wait 5000
wav demo5_aeolian.wav
tap PLAY
wait 253000
wavstop
