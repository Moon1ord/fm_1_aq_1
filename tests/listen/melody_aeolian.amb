# Six minutes of the full mix in Aeolian, at the knobs' defaults, with a fixed seed. Not one of the tests. The melody's score: "mel" lines in the trace.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/melody_aeolian.amb app/build/listen
master 2430
tap PLAY
wait 200
seed 1003
style liquid
turn ALGO 2
expect pool 0x5AD
tap GLO
spin K1 7
tap HOME
wait 200
trace app/build/listen/melody_aeolian.trace
wav melody_aeolian.wav
tap PLAY
wait 360000
wavstop
trace off
