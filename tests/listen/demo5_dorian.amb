# demo5: the harmony from the pool. D Dorian: stopped first, so the song starts from its top in this key.
#   PYTHON=.venv/bin/python3 sh build.sh --host && app/build/host/aq1_host tests/listen/demo5_dorian.amb app/build/listen
master 2430
tap PLAY
wait 200
turn ALGO -2

expect par19 2
expect par20 1
expect pool 0x6AD
wait 5000
wav demo5_dorian.wav
tap PLAY
wait 253000
wavstop
