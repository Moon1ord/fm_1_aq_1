expect par41 4
expect par42 30
expect par43 40
expect par44 200
expect par45 0
expect enagree 0
flood 200
turn PRESET 1 1
turn PRESET -1 1
wait 60
expect enagree 0
expect par36 1
expect par41 4
expect par45 0
