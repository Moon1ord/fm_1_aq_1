# the player's arrangement, as a hand has it. Hands from power-on and every recipe: the keys and the pad; SELECT + a page's button, a real switch; Energy the density, never a layer; EDIT, a section and nothing by itself; a piece keeps the set; power-on the start. SELECT + HOME, Auto
wait 300
expect unfit 0
listen
expect view 0
expect mode 1
expect arrange 1
expect playing 1
# ---- the start
expect mutekeys 0
expect mutemel 1
expect mutebass 1
expect mutedrums 1
expect mutehats 1
expect gain0 100
expect gain1 0
expect gain2 0
expect gain3 0
expect gain4 0
expect section 2
# the buttons of what is off have no glow; what is on has
expect dim2 1
expect dim3 0
wait 3000
expect meter0 >0
expect meter1 0
expect meter2 0
expect meter3 0
# what is off still sends its MIDI: it has a beat, on 10, heard or not
expect level 3
out
wait 3000
expect_out USB 89 24 00
# a page button alone: its page, as ever; SELECT alone: nothing
tap LFO
expect view 3
tap SEL
wait 100
expect view 3
expect mutebass 1
tap HOME
expect view 0
# ---- the switch: SELECT + LFO: the bass ON, on the bar. The page stays, the level is not touched, it says so, the glow comes
expect par12 50
press SEL
tap LFO
release SEL
said BASS ON
wait 20
expect view 0
expect mutebass 0
expect par12 50
expect dirty 0
expect dim3 1
wait 2000
expect gain2 100
wait 3000
expect meter2 >0
# and off, on the bar too
press SEL
tap LFO
release SEL
said BASS OFF
wait 20
expect mutebass 1
expect dim3 0
wait 2000
expect gain2 0
# (the page you are on stays lit, off or not; leave it and it goes dark)
tap LFO
expect view 3
wait 20
expect lit3 1
tap HOME
wait 20
expect lit3 0
expect dim3 0
# each of them, one press of SELECT for several
press SEL
tap ARP
said MELODY ON
tap LFO
said BASS ON
tap SEQ
said DRUMS ON
tap FX
said HATS ON
release SEL
wait 20
expect view 0
expect mutemel 0
expect mutebass 0
expect mutedrums 0
expect mutehats 0
wait 2500
expect gain1 100
expect gain2 100
expect gain3 100
expect gain4 100
# the drums on the bar (how exactly: hands_test); the keys go over a second
press SEL
tap SEQ
release SEL
wait 2000
expect gain3 0
press SEL
tap SEQ
release SEL
wait 2000
expect gain3 100
press SEL
tap ENV
release SEL
said KEYS OFF
wait 100
expect gain0 >50
expect gain0 <100
wait 500
expect gain0 <60
wait 900
expect gain0 0
press SEL
tap ENV
release SEL
said KEYS ON
wait 1200
expect gain0 100
# all off: the meters read empty, MIDI goes on on all five
press SEL
tap ENV
tap ARP
tap SEQ
tap FX
tap LFO
release SEL
wait 12000
expect meter0 0
expect meter1 0
expect meter2 0
expect meter3 0
expect midion1 >0
expect midion4 >0
expect par4 60
expect par8 60
expect par16 45
expect par18 50
expect par12 50
# a break asked for with the drums off is told no
press SEL
tap EDIT
release SEL
said NO DRUMS NO BREAK
# SELECT let go: no page, no card. The level knobs still move and nothing comes on by that
expect help 0
tap ENV
expect view 1
spin K1 1
expect par4 61
spin K1 -1
expect mutekeys 1
tap HOME
# the drums and hats back
press SEL
tap ENV
tap SEQ
tap FX
release SEL
wait 3000
expect mutedrums 0
expect gain3 100
expect meter0 >0
# ---- Energy: the density, the whole way: never a layer. A beat at 0, on the bar. It turns nothing on or off
expect par1 70
spin K2 -70
expect par1 0
wait 2000
expect level 4
expect gain3 100
expect mutedrums 0
expect mutebass 1
wait 3000
spin K2 34
wait 2000
expect level 4
spin K2 1
wait 2000
expect level 2
spin K2 24
wait 2000
expect level 2
spin K2 1
wait 2000
expect level 3
spin K2 40
wait 2000
expect level 3
expect mutebass 1
expect mutemel 1
expect gain3 100
expect section 2
spin K2 -30
expect par1 70
# the switches at the ends of it: hats by themselves at Energy 0
spin K2 -70
press SEL
tap SEQ
release SEL
wait 3000
expect gain3 0
expect gain4 100
press SEL
tap SEQ
release SEL
wait 2000
spin K2 70
wait 2000
# ---- every style has the range. Drift, Loading: Energy 0 half time, Energy 100 full
style drift
energy 0
wait 2000
expect level 4
expect gain3 100
energy 100
wait 2000
expect level 3
style loading
energy 0
wait 2000
expect level 4
energy 100
wait 2000
expect level 3
style liquid
energy 70
wait 2000
# ---- nothing by itself, however long
wait 179200
expect section 2
expect mode 1
expect level 3
expect breakbars 0
# EDIT: the next section, and it stays; the drums stay Energy's; the new chord on the bar
tap EDIT
said NEXT SECTION ON THE BAR
wait 1600
expect section 3
expect level 3
wait 40000
expect section 3
expect level 3
tap EDIT
wait 1600
expect section 4
expect level 3
# ---- SELECT + EDIT: a break: the Breaks knob's length: and the place is as it was. By itself none
breaks 100
wait 30000
expect breakbars 0
breaks 0
press SEL
tap EDIT
release SEL
said BREAK ON THE BAR
wait 1420
expect breakbars 1
wait 3000
expect breakbars 0
expect section 4
expect level 3
breaks 100
press SEL
tap EDIT
release SEL
wait 1420
expect breakbars 4
wait 8000
expect breakbars 0
expect section 4
expect level 3
breaks 50
wait 100
# the meters: full of what is playing; a layer off reads empty, playing or not
expect meter3 >0
press SEL
tap SEQ
release SEL
wait 3000
expect meter3 0
press SEL
tap SEQ
release SEL
wait 3000
expect meter3 >0
# the card of a held button still comes up, and says so; with SELECT held there is none
press ENV
wait 1000
expect help 3
release ENV
wait 50
expect help 0
expect view 0
press SEL
press ENV
wait 1000
expect help 0
release ENV
release SEL
expect view 0
expect mutekeys 1
press SEL
tap ENV
release SEL
# SELECT + GLO has no layer: it does nothing, not even the page
press SEL
tap GLO
release SEL
expect view 0
# HOME's own: held with the SELECT encoder, the tempo
press HOME
turn SELECT 2 200
release HOME
expect par0 172
expect view 0
expect mode 1
spin K1 -2
expect par0 170
# ---- the next piece keeps which layers are on: bass and melody off, drums and hats on, as they are now
wait 200
expect mutekeys 0
expect mutemel 1
expect mutebass 1
expect mutedrums 0
expect mutehats 0
turn PRESET 1
wait 200
expect piece 1
expect mode 1
expect arrange 1
expect mutekeys 0
expect mutemel 1
expect mutebass 1
expect mutedrums 0
expect mutehats 0
wait 2000
expect gain3 100
expect gain2 0
turn PRESET -1
wait 200
expect piece 0
expect mutebass 1
expect mutedrums 0
# ... through all eight
press SEL
tap LFO
release SEL
turn PRESET 3
wait 200
expect piece 3
expect style 4
expect mutebass 0
expect mutedrums 0
expect mutemel 1
turn PRESET -3
wait 200
expect piece 0
# SAVE held: the piece back to its recipe: Hands, and the set stands
press SAVE
wait 1800
release SAVE
wait 200
said RESET
expect mode 1
expect arrange 1
expect mutebass 0
expect mutedrums 0
expect mutemel 1
# ---- power-on: the start again, however it was left and saved; the mode is the piece's
tap SAVE
wait 800
said SAVED
reboot
wait 300
expect mode 1
expect mutekeys 0
expect mutemel 1
expect mutebass 1
expect mutedrums 1
expect mutehats 1
expect gain3 0
# Hands, off to a rest and back: there is no bar to wait for
tap PLAY
wait 200
expect playing 0
press SEL
tap LFO
release SEL
wait 100
expect gain2 100
press SEL
tap LFO
release SEL
wait 100
expect gain2 0
tap PLAY
wait 200
# ---- Auto, by SELECT + HOME: its own set, all on, on the bar; the place goes on; back, the player's set as it was
expect section 2
press SEL
tap ARP
release SEL
press SEL
tap HOME
release SEL
said AUTO
wait 50
expect mode 0
expect arrange 0
expect dirty 1
expect mutekeys 0
expect mutemel 0
expect mutebass 0
expect mutedrums 0
expect mutehats 0
wait 2000
expect gain3 100
expect gain2 100
press SEL
tap HOME
release SEL
said HANDS
wait 50
expect mode 1
expect mutemel 0
expect mutebass 1
expect mutedrums 1
expect mutehats 1
press SEL
tap HOME
release SEL
wait 50
expect mode 0
# a piece from Auto: that piece's mode (a recipe's: Hands), and Hands' set
turn PRESET 1
wait 200
expect mode 1
expect arrange 1
expect mutemel 0
expect mutedrums 1
turn PRESET -1
wait 200
expect mode 0
expect mutedrums 0
# ---- Auto, saved, from the top: all on, the arranger's, with the drums absent in the intro
tap SAVE
wait 800
reboot
wait 300
expect mode 0
expect mutemel 0
expect mutebass 0
expect mutedrums 0
expect mutehats 0
expect section 0
expect level 0
wait 2000
expect absent 28
# the switch on what the arranger has absent: it stays on, it says so, and on the bar the first place the drums play: the light
press SEL
tap SEQ
release SEL
said DRUMS ON
wait 2000
expect mutedrums 0
expect section 2
expect level >1
expect absent 4
# on what is playing: a mute, as ever, the place not moved
press SEL
tap SEQ
release SEL
said DRUMS OFF
wait 2000
expect mutedrums 1
expect section 2
expect gain3 0
# and back
press SEL
tap SEQ
release SEL
said DRUMS ON
wait 2000
expect gain3 100
expect section 2
# the bass is not in the light's first phrase: the switch goes on to the second, where it is
press SEL
tap LFO
release SEL
said BASS ON
wait 2000
expect absent 0
expect section 2
expect mutebass 0
# the panic and its way back leave what is off, off
press SEL
tap FX
release SEL
said HATS OFF
panic
wait 200
expect silent 1
expect mutehats 1
uiinit
wait 200
expect silent 0
expect mutehats 1
