# Six minutes of jungle, from the top, with a fixed seed. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/gen_jungle.amb app/build/listen
# (in Auto, saved, as it boots: this is the arranger's, from the top. Hands is the power-on's: hands.amb, preset_*.amb)
press SEL
tap HOME
release SEL
tap SAVE
wait 800
reboot
master 2430
tap PLAY
wait 200
seed 1003
style jungle
wait 200
trace app/build/listen/gen_jungle.trace
wav gen_jungle.wav
tap PLAY
wait 360000
wavstop
trace off
