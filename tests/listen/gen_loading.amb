# Six minutes of loading, from the top, with a fixed seed. Not one of the tests.
#   PYTHON=.venv/bin/python3 sh build.sh --host && mkdir -p app/build/listen && app/build/host/aq1_host tests/listen/gen_loading.amb app/build/listen
master 2430
tap PLAY
wait 200
seed 1006
style loading
wait 200
trace app/build/listen/gen_loading.trace
wav gen_loading.wav
tap PLAY
wait 360000
wavstop
trace off
